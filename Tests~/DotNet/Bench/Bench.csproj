<Project Sdk="Microsoft.NET.Sdk">
  <!-- Benchmarks for the core engine. Run from the package root: dotnet run -c Release (project Tests~/DotNet/Bench) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../Tests/Runtime/BenchmarkData.cs" />
    <ProjectReference Include="../Core/DynamicDialog.Core.csproj" />
  </ItemGroup>
</Project>
